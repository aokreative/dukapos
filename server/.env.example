# Duka POS backend — copy to .env and fill in to go live.
# With NOTHING set, every provider runs in simulation mode.

PORT=8787
# Public base URL the M-PESA callback can reach (use an ngrok/https URL in dev).
PUBLIC_URL=http://localhost:8787

# --- Database (subscriptions) ---
# Leave blank to store shops in a local JSON file (fine for one small instance).
# For production, paste a Postgres connection string (Supabase / Neon / Render).
# The table is created automatically on startup (see schema.sql).
DATABASE_URL=

# How often the auto-charge scheduler runs (ms). Default 1 hour.
BILLING_INTERVAL_MS=3600000

# --- Super-Admin portal (platform owner) ---
# Set a long, secret password to enable your admin portal at /admin and protect
# the /api/admin/* endpoints. If blank, the portal and admin APIs are disabled.
ADMIN_TOKEN=

# --- WhatsApp Cloud API (Meta) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# --- Africa's Talking (SMS) ---
AT_API_KEY=
AT_USERNAME=
AT_SENDER_ID=

# --- M-PESA Daraja (subscription collection) ---
MPESA_ENV=sandbox            # sandbox | production
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_TX_TYPE=CustomerPayBillOnline   # or CustomerBuyGoodsOnline for Till

# --- Airtel Money (Airtel Africa Open API) ---
AIRTEL_ENV=staging           # staging | production
AIRTEL_CLIENT_ID=
AIRTEL_CLIENT_SECRET=
AIRTEL_COUNTRY=KE
AIRTEL_CURRENCY=KES

# --- KRA eTIMS (electronic tax invoices) ---
# Requires onboarding with KRA first — see INTEGRATIONS.md.
ETIMS_ENDPOINT=
ETIMS_TIN=
ETIMS_BHF_ID=00
ETIMS_CMC_KEY=

# --- Duka AI (Google Gemini) ---
# Get a key at https://aistudio.google.com → Get API key. Without it, the
# in-app assistant still works using built-in local answers.
GEMINI_API_KEY=
# "gemini-flash-latest" (default) always points to the current fast Flash model.
AI_MODEL=gemini-flash-latest
# Daily AI questions allowed per shop before the upgrade prompt (default 50).
AI_DAILY_QUOTA=50
